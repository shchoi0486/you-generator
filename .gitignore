# --- dependencies ---
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# --- build outputs ---
frontend/dist/
frontend/dist-ssr/
frontend/src-tauri/target/
frontend/src-tauri/binaries/
frontend/src-tauri/gen/
backend/dist/
backend/build/
*.spec_old

# --- PyInstaller one-dir / one-file sidecars (rebuild via spec) ---
backend/dist/
frontend/src-tauri/binaries/you-backend-*/

# --- app runtime data (generated media, exports) ---
data/
*.mp4
*.mp3
*.wav
*.srt
!**/fixtures/**

# --- secrets (API keys live here) ---
backend/config/settings.yaml

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
npm-debug.log*

# --- Rust ---
target/
# NOTE: Cargo.lock은 앱 재현 빌드를 위해 커밋 유지 (라이브러리라면 무시)

# --- browser automation profiles (20MB+ per run, never commit) ---
backend/chrome_profile/
**/chrome_profile/

# --- test run artifacts (generated by manual paid-API test runs) ---
backend/tests/last_*.json
backend/tests/_*.txt
